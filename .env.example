# Copy this file to .env and fill in the keys you have:
#   cp .env.example .env
# Only the providers you plan to call need a key. The mock-model needs none.

# --- Proxy ---
# Key clients use to talk to the proxy. Required: the proxy refuses to start without it.
# Generate your own (don't reuse a sample value):
#   python -c "import secrets; print('sk-' + secrets.token_hex(32))"
LITELLM_MASTER_KEY=
# Where test_litellm.py sends requests
LITELLM_PROXY_URL=http://localhost:4000

# --- Provider keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
