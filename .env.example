# Copy this file to .env:   cp .env.example .env

# Must match general_settings.master_key in litellm_config.yaml
LITELLM_MASTER_KEY=sk-local-free
LITELLM_PROXY_URL=http://localhost:4000/v1

# Optional, for free-cloud. Free key, no card: https://openrouter.ai/keys
# Without it, free-cloud requests fall back to free-local.
OPENROUTER_API_KEY=
