# Copy this file to .env:   cp .env.example .env
# Everything here is free. The provider keys are optional: leave a key blank
# and that provider's models simply won't answer. mock-model and local-llama
# (Ollama) need no key at all.

# --- Proxy (required) ---
# The proxy refuses to start without a master key. Generate your own:
#   python -c "import secrets; print('sk-' + secrets.token_hex(32))"
LITELLM_MASTER_KEY=
LITELLM_PROXY_URL=http://localhost:4000

# --- Optional free provider keys ---
# OpenRouter: https://openrouter.ai/keys  (free :free models, no card needed)
OPENROUTER_API_KEY=
# Groq: https://console.groq.com/keys  (free tier, no card needed)
GROQ_API_KEY=
